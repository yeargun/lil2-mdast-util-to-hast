{
  "name": "@itslil/lil2-mdast-util-to-hast",
  "version": "0.1.0",
  "description": "mdast-util-to-hast, rewritten in typed LilScript: mdast arena to hast arena, same trees",
  "type": "module",
  "license": "MIT",
  "author": "yeargun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeargun/lil2-mdast-util-to-hast.git"
  },
  "bugs": {
    "url": "https://github.com/yeargun/lil2-mdast-util-to-hast/issues"
  },
  "homepage": "https://yeargun.github.io/lil2-mdast-util-to-hast/",
  "keywords": [
    "mdast",
    "hast",
    "mdast-util",
    "markdown",
    "html",
    "ast",
    "lilscript",
    "lil2",
    "typed",
    "fast"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/to-hast.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "convex": "./dist/to-hast.js",
      "deno": "./dist/to-hast.js",
      "edge-light": "./dist/to-hast.js",
      "react-native": "./dist/to-hast.js",
      "worker": "./dist/to-hast.js",
      "workerd": "./dist/to-hast.js",
      "browser": "./dist/browser/to-hast.js",
      "default": "./dist/to-hast.js"
    },
    "./constants": {
      "types": "./types/constants.d.ts",
      "convex": "./dist/constants.js",
      "deno": "./dist/constants.js",
      "edge-light": "./dist/constants.js",
      "react-native": "./dist/constants.js",
      "worker": "./dist/constants.js",
      "workerd": "./dist/constants.js",
      "browser": "./dist/browser/constants.js",
      "default": "./dist/constants.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "types",
    "NOTICE.md"
  ],
  "scripts": {
    "check:sources": "node scripts/shared-sources.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "build": "node scripts/build.mjs",
    "test": "npm run check:sources && node --test test/differential.test.mjs test/browser.test.mjs"
  },
  "devDependencies": {
    "character-entities": "2.0.2",
    "commonmark.json": "^0.31.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-to-hast": "13.2.1",
    "playwright-core": "^1.62.0",
    "property-information": "^7.2.0"
  }
}
